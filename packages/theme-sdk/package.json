{
  "name": "@fdraft/theme-sdk",
  "version": "0.1.0",
  "description": "Framework-neutral contract, validation, packaging, and compiler for FDraft Studio theme and project data.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/packaging/nodeFs.d.ts",
      "import": "./dist/packaging/nodeFs.js"
    },
    "./packaging": {
      "types": "./dist/packagingIndex.d.ts",
      "import": "./dist/packagingIndex.js"
    }
  },
  "bin": {
    "fdraft-theme": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:schemas": "tsx scripts/generate-json-schemas.ts",
    "check:schemas": "tsx scripts/generate-json-schemas.ts --check",
    "generate:fixtures": "tsx scripts/write-sample-fixture.ts && tsx scripts/write-sample-fdtheme.ts",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.21.0"
}

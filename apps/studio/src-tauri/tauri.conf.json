{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FDraft Studio",
  "version": "0.1.0",
  "identifier": "com.fdraftstudio.app",
  "build": {
    "beforeDevCommand": "vite",
    "beforeBuildCommand": "tsc --noEmit && vite build",
    "devUrl": "http://localhost:5190",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FDraft Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
